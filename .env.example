APP_ENV=dev

# Logs print to the local terminal and rotate on disk by default.
LOG_LEVEL=INFO
LOG_TO_CONSOLE=true
LOG_TO_FILE=true
LOG_FILE=logs/exam_helper.log
LOG_MAX_BYTES=5000000
LOG_BACKUP_COUNT=5

# Same WhatsApp variable names as Student Evaluator.
VERIFY_TOKEN=change_me
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_GRAPH_VERSION=v25.0

# Local simulator routes. Keep false in production.
ENABLE_SIMULATOR=false

# PostgreSQL on Render. SQLite can be used only for local development/tests.
DATABASE_URL=sqlite:///./exam_helper_local.db
DATABASE_AUTO_CREATE_TABLES=true

# For terminal-only testing, choose a teacher that exists in teacher_profile.
LOCAL_TEACHER_WHATSAPP_NUMBER=

# Exam generation.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o
MOCK_GENERATION=false
FAST_EXAM_MODE=true
HINDI_FONT_PATH=
